# ==============================================================================
# Google Cloud Storage to Google Drive Mover Configuration
# ==============================================================================

# Path to the Google Cloud Storage Service Account JSON key file
# Requires roles: Storage Object Viewer (to read), Storage Object Admin (to delete/move)
GCS_SERVICE_ACCOUNT_KEY="./secrets/gcs-service-account.json"

# Path to the Google Drive Service Account JSON key file
# Requires the Service Account email to be shared with the target Google Drive Folder
# (Permission: Content Manager, Editor, or Contributor)
GDRIVE_SERVICE_ACCOUNT_KEY="./secrets/gdrive-service-account.json"

# Target Google Drive Folder ID (found in the URL of the folder: drive.google.com/drive/folders/<FOLDER_ID>)
# Leave blank to upload to root "My Drive"
GDRIVE_FOLDER_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs7"

# Resumable upload chunk size in bytes (must be a multiple of 262144 bytes / 256 KiB)
# Default is 26214400 bytes (25 MiB)
GDRIVE_CHUNK_SIZE="26214400"

# Temporary directory for local buffering during transfer (default: /tmp)
TEMP_DIR="/tmp"

# Set to true to keep files in GCS (Copy mode). Default is false (Move mode: deletes from GCS after upload)
KEEP_SOURCE="false"

# Optional: Direct OAuth2 access tokens (if already obtained externally)
# GCS_ACCESS_TOKEN=""
# GDRIVE_ACCESS_TOKEN=""
